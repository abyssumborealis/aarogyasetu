# Copy to .env (same folder as docker-compose.yml) and fill in. NEVER commit .env.

POSTGRES_USER=queue_user
POSTGRES_PASSWORD=123123123              # required - choose a long random password
POSTGRES_DB=queue_db

# required. Generate one:   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=import secrets; print(secrets.token_hex(32))

# Where the site is served.  Local: :80      Live: your domain, e.g. queue.example.com
SITE_ADDRESS=:80
# The browser origin(s) of the frontend, comma separated.  Local: http://localhost   Live: https://queue.example.com
CORS_ORIGINS=http://localhost

HOSPITAL_TIMEZONE=Asia/Kolkata
NOTIFY_CHANNELS=in_app             # add sms / push only after you register real senders (services/notify.py)
