{$SITE_ADDRESS} {
	encode gzip

	header {
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
	}

	# API: strip /api and forward to FastAPI (root_path=/api)
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# All-in-one test UI (frontend/index.html)
	handle /site/* {
		root * /srv
		file_server
	}

	# Admin app
	handle /admin/* {
		root * /srv
		file_server
	}

	# Patient app at the root
	handle {
		root * /srv/patient
		try_files {path} /index.html
		file_server
	}
}

