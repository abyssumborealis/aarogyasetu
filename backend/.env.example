# Copy to .env and fill in real values. Never commit the actual .env file.

DATABASE_URL=postgresql+psycopg://queue_user:queue_pass@db:5432/queue_db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-real-random-secret

TIMEZONE=Asia/Kolkata

NOTIFY_CHANNELS=["in_app","sms"]

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
