services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: queue_user
      POSTGRES_PASSWORD: ${DB_PASSWORD:-1f1661e74699aabba7c53c9e57e534c0}
      POSTGRES_DB: queue_db
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U queue_user -d queue_db"]
      interval: 5s
      timeout: 3s
      retries: 10

  backend:
    build: ./backend
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql+psycopg://queue_user:${DB_PASSWORD:-1f1661e74699aabba7c53c9e57e534c0}@db:5432/queue_db
      ROOT_PATH: /api

  web:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on:
      - backend
    ports:
      - "80:80"
      - "443:443"
    environment:
      SITE_ADDRESS: ${SITE_ADDRESS:-:80}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./patient_frontend:/srv/patient:ro
      - ./admin_frontend:/srv/admin:ro
      - ./frontend:/srv/site:ro
      - caddy_data:/data          # TLS certificates - keep this volume
      - caddy_config:/config

volumes:
  postgres_data:
  caddy_data:
  caddy_config:

